# ------------------------------------------------------------
# Modern Skills — backend .env template
# Copy this file to .env (same folder) and fill in your own values.
# .env is gitignored — it is never pushed to GitHub.
# ------------------------------------------------------------

# --- Supabase (recommended) ---
# Project URL + keys from Supabase Dashboard > Project Settings > API.
# The service-role key is used server-side (bypasses RLS) — never expose it
# to the browser; only SUPABASE_ANON_KEY goes to the frontend.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Storage buckets (created via supabase/Schrema.sql)
SUPABASE_AVATAR_BUCKET=avatars
SUPABASE_VIDEO_BUCKET=videos
SUPABASE_THUMBNAIL_BUCKET=thumbnails
SUPABASE_BOOK_BUCKET=books

# Admin account (synced on every start via init.js)
ADMIN_PASSWORD=change-me
ADMIN_EMAIL=admin@example.com
ADMIN_USERNAME=admin

# JWT Secret for authentication (generate a secure random string for production)
JWT_SECRET=change-me-to-a-long-random-string

# File uploads
UPLOAD_DIR=./uploads
MAX_VIDEO_SIZE_MB=500
MAX_IMAGE_SIZE_MB=5
MAX_BOOK_SIZE_MB=50

# Frontend URL (for CORS). A local run needs no CORS entry — the frontend
# and the API share http://localhost:3001.
FRONTEND_URL=

# Server port (change if 3001 is in use)
PORT=3001
